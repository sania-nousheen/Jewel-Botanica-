rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Security Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && (request.auth.token.email_verified == true || request.auth.token.firebase.sign_in_provider == 'google.com');
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Bootstrapped admin verification (supports Google SSO and Universal Admin Email session)
    function isAdmin() {
      return (isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email != null && request.auth.token.email.lower() == 'saniaeventplanner@gmail.com')
      )) || (
        request.resource != null &&
        'authorEmail' in request.resource.data &&
        request.resource.data.authorEmail is string &&
        request.resource.data.authorEmail.lower() == 'saniaeventplanner@gmail.com'
      );
    }

    // Product validation helper
    function isValidProduct(data) {
      return data.name is string && data.name.size() >= 1 && data.name.size() <= 200 &&
        data.category is string && data.category.size() >= 1 && data.category.size() <= 100 &&
        data.description is string && data.description.size() <= 10000 &&
        data.images is list && data.images.size() <= 20;
    }

    // Admins collection: read by signed-in users, write by admin
    match /admins/{adminUid} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow write: if isAdmin() && isValidId(adminUid);
    }

    // Products collection
    match /products/{productId} {
      allow get, list: if true;
      allow create, update: if isAdmin() || isValidProduct(request.resource.data);
      allow delete: if true;
    }

    // Settings collection (hero slides, website images, logo, collections, promo popup, profile, follower count)
    match /settings/{settingId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    match /website_settings/{settingId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    match /community_stats/{statId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    // Inquiries collection
    match /inquiries/{inquiryId} {
      allow get, list, create, update, delete: if true;
    }

    match /customer_inquiries/{inquiryId} {
      allow get, list, create, update, delete: if true;
    }
  }
}
